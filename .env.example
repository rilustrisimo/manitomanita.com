# Copy to .env (same folder) and fill in. .env is never committed.
# Anything already defined in wp-config.php takes priority.

# PayPal (developer.paypal.com > Apps & Credentials > Live)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=live

# Involve Asia Publisher API
INVOLVE_API_KEY=
INVOLVE_API_SECRET=

# Gemini gift ideas (aistudio.google.com)
GEMINI_API_KEY=

# Cloudflare Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
